<UserControl x:Class="MsfsPhysicsCamera.RangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="24" SizeChanged="UserControl_SizeChanged">
    <Grid>
        <!-- Background track -->
        <Border Height="4" Background="{StaticResource TrackBrush}" VerticalAlignment="Center" Margin="5,0" CornerRadius="2"/>
        <!-- Active track -->
        <Border x:Name="ActiveTrack" Height="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="2"/>

        <Canvas x:Name="SliderCanvas" Margin="5,0">
            <Thumb x:Name="MinThumb" Width="16" Height="16" Canvas.Top="4" Cursor="Hand" Template="{StaticResource RoundThumb}"
                   DragDelta="MinThumb_DragDelta" DragStarted="MinThumb_DragStarted" DragCompleted="Thumb_DragCompleted" />
            <Thumb x:Name="MaxThumb" Width="16" Height="16" Canvas.Top="4" Cursor="Hand" Template="{StaticResource RoundThumb}"
                   DragDelta="MaxThumb_DragDelta" DragStarted="MaxThumb_DragStarted" DragCompleted="Thumb_DragCompleted" />
        </Canvas>
    </Grid>
</UserControl>
