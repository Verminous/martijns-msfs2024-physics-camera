<UserControl x:Class="MsfsPhysicsCamera.SettingSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MsfsPhysicsCamera"
             x:Name="Root">
    <StackPanel Margin="0,0,0,10" Background="Transparent" ToolTip="{Binding Hint, ElementName=Root}" ToolTipService.InitialShowDelay="400">
        <DockPanel>
            <TextBlock x:Name="ValueText" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="{Binding Label, ElementName=Root}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
        </DockPanel>
        <Grid Margin="0,2,0,0">
            <!-- Track and fill (from zero), drawn under the slider; the slider's thumb centre spans exactly this width. -->
            <local:Meter VerticalAlignment="Center" IsHitTestVisible="False"
                         Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}" Value="{Binding Value, ElementName=Root}" />
            <Slider Margin="-8,0" Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}"
                    TickFrequency="{Binding Step, ElementName=Root}" IsSnapToTickEnabled="True"
                    SmallChange="{Binding Step, ElementName=Root}" LargeChange="{Binding Step, ElementName=Root}"
                    Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
        </Grid>
    </StackPanel>
</UserControl>
